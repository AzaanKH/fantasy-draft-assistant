// Cloudflare Workers Builds serves the static web app; `wrangler preview`
// needs the `previews` block, which can stay empty.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fantasy-draft-assistant",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "./web-app/dist",
    "not_found_handling": "single-page-application"
  },
  "previews": {}
}
