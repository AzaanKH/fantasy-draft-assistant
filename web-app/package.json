{
  "name": "web-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "node ../scripts/lint.mjs web-app",
    "test": "vitest run --config ../vitest.config.js --project web-app",
    "rehearse:primary-league": "tsx --conditions=@fantasy-draft/source src/features/draft-room/run-primary-league-rehearsal.ts",
    "profile:recommendations": "tsx --conditions=@fantasy-draft/source src/lib/calculations/profile-recommendations.ts",
    "test:watch": "vitest --config ../vitest.config.js --project web-app",
    "clean": "rm -rf dist node_modules/.vite"
  },
  "dependencies": {
    "@fantasy-draft/shared": "workspace:*",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-virtual": "^3.14.28",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "^4.1.5",
    "immer": "^11.2.10",
    "lucide-react": "^1.79.0",
    "motion": "^13.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "18.3.1",
    "recharts": "^3.11.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.2",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "fake-indexeddb": "^6.2.6",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  }
}
