{
  "name": "@fantasy-draft/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./draft": {
      "@fantasy-draft/source": "./src/draft/index.ts",
      "types": "./dist/draft/index.d.ts",
      "import": "./dist/draft/index.js"
    },
    "./catalog": {
      "@fantasy-draft/source": "./src/catalog/index.ts",
      "types": "./dist/catalog/index.d.ts",
      "import": "./dist/catalog/index.js"
    },
    "./league": {
      "@fantasy-draft/source": "./src/league/index.ts",
      "types": "./dist/league/index.d.ts",
      "import": "./dist/league/index.js"
    },
    "./node": {
      "@fantasy-draft/source": "./src/node/index.ts",
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./sync": {
      "@fantasy-draft/source": "./src/sync/index.ts",
      "types": "./dist/sync/index.d.ts",
      "import": "./dist/sync/index.js"
    },
    "./units": {
      "@fantasy-draft/source": "./src/units/index.ts",
      "types": "./dist/units/index.d.ts",
      "import": "./dist/units/index.js"
    },
    "./http": {
      "@fantasy-draft/source": "./src/http/index.ts",
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json --force",
    "typecheck": "tsc --noEmit",
    "lint": "node ../scripts/lint.mjs shared",
    "test": "vitest run --config ../vitest.config.js --project shared",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "effect": "^4.0.0"
  }
}
