{
  "name": "@fantasy-draft/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@fantasy-draft/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./draft": {
      "@fantasy-draft/source": "./src/draft/index.ts",
      "types": "./dist/draft/index.d.ts",
      "import": "./dist/draft/index.js"
    },
    "./catalog": {
      "@fantasy-draft/source": "./src/catalog/index.ts",
      "types": "./dist/catalog/index.d.ts",
      "import": "./dist/catalog/index.js"
    },
    "./draft-url": {
      "@fantasy-draft/source": "./src/draft-url.ts",
      "types": "./dist/draft-url.d.ts",
      "import": "./dist/draft-url.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json --force",
    "typecheck": "tsc --noEmit",
    "lint": "node ../scripts/lint.mjs shared",
    "test": "vitest run --config ../vitest.config.js --project shared",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "effect": "^4.0.0"
  }
}
