{
  "name": "scripts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --conditions=@fantasy-draft/source src/dev.ts",
    "scrape:ecr": "tsx --conditions=@fantasy-draft/source src/scrape-ecr.ts",
    "refresh:fantasypros-snapshot": "tsx --conditions=@fantasy-draft/source src/refresh-fantasypros-snapshot.ts",
    "scrape:contracts": "tsx --conditions=@fantasy-draft/source src/scrape-contracts.ts",
    "refresh:contracts": "tsx --conditions=@fantasy-draft/source src/refresh-contracts.ts",
    "fetch:sleeper": "tsx --conditions=@fantasy-draft/source src/fetch-sleeper-adp.ts",
    "import:sportsbook": "python3 import-sportsbook-lines.py",
    "build:player-identity": "tsx --conditions=@fantasy-draft/source src/build-player-identity.ts",
    "check:data-freshness": "tsx --conditions=@fantasy-draft/source src/check-data-freshness.ts",
    "check:data-quality": "tsx --conditions=@fantasy-draft/source src/check-data-quality.ts",
    "check:draft-readiness": "tsx --conditions=@fantasy-draft/source src/check-draft-readiness.ts",
    "prepare:live-draft": "tsx --conditions=@fantasy-draft/source src/prepare-live-draft.ts",
    "primary-league:release-gate": "tsx --conditions=@fantasy-draft/source src/primary-league-release-gate.ts",
    "check:dev-ports": "tsx --conditions=@fantasy-draft/source src/check-dev-ports.ts",
    "measure:web-bundle": "tsx --conditions=@fantasy-draft/source src/measure-web-bundle.ts",
    "measure:effect-adoption": "tsx --conditions=@fantasy-draft/source src/measure-effect-adoption.ts",
    "import:league-history": "tsx --conditions=@fantasy-draft/source src/import-league-draft-history.ts",
    "build:league-survival": "tsx --conditions=@fantasy-draft/source src/build-league-survival-model.ts",
    "build:demo-data": "tsx --conditions=@fantasy-draft/source src/build-demo-data.ts",
    "install:demo-data": "tsx --conditions=@fantasy-draft/source src/install-demo-data.ts",
    "check:demo-data": "tsx --conditions=@fantasy-draft/source src/check-demo-data.ts",
    "generate:team-env": "tsx --conditions=@fantasy-draft/source src/generate-team-env.ts",
    "generate:draft-prep": "tsx --conditions=@fantasy-draft/source src/generate-draft-prep-report.ts",
    "backtest:recommendations": "tsx --conditions=@fantasy-draft/source src/backtest-recommendations.ts",
    "backtest:contracts": "tsx --conditions=@fantasy-draft/source src/backtest-contract-years.ts",
    "fetch:all": "tsx --conditions=@fantasy-draft/source src/scrape-ecr.ts && tsx --conditions=@fantasy-draft/source src/fetch-sleeper-adp.ts && tsx --conditions=@fantasy-draft/source src/generate-team-env.ts",
    "model:duckdb:init": "tsx --conditions=@fantasy-draft/source src/model/init-duckdb.ts",
    "model:profile": "tsx --conditions=@fantasy-draft/source src/model/profile-model-sources.ts",
    "model:dataset": "tsx --conditions=@fantasy-draft/source src/build-prediction-dataset.ts",
    "model:snapshots": "tsx --conditions=@fantasy-draft/source src/build-historical-snapshots.ts",
    "test": "vitest run --config ../vitest.config.js --project scripts",
    "typecheck": "tsc --noEmit",
    "lint": "node ../scripts/lint.mjs scripts",
    "clean": "rm -rf dist",
    "browser:gate": "tsx --conditions=@fantasy-draft/source src/browser-gate.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.3-r.2",
    "@fantasy-draft/shared": "workspace:*",
    "dotenv": "^16.6.1",
    "effect": "^4.0.0",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  }
}
