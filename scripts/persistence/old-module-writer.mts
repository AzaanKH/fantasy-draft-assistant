import assert from 'node:assert/strict';
import { writeFileSync } from 'node:fs';
import { pathToFileURL } from 'node:url';
const [root, output] = process.argv.slice(2);
if (!root || !output) throw new Error('Pass an extracted old checkout and output path');
const { createDraftStore } = await import(pathToFileURL(`${root}/web-app/src/stores/draftStore.ts`).href);
const identity = { provider: 'sleeper', draftId: '123' };
const key = 'fantasy-draft-session-v1:sleeper:123';
const values = new Map<string, string>();
const storage = { getItem: (key: string) => values.get(key) ?? null, setItem: (key: string, value: string) => { values.set(key, value); },
  removeItem: (key: string) => { values.delete(key); }, key: (index: number) => [...values.keys()][index] ?? null, get length() { return values.size; } };
const store = createDraftStore({ storage, session: identity });
const actions = store.getState();
actions.setSessionMode('live');
actions.setConfig({ totalTeams: 10, totalRounds: 14, myPickPosition: 2 });
actions.preloadKeepers([{ playerId: 'keeper', playerName: 'Keeper', position: 'RB', teamIndex: 1, round: 10, isMyKeeper: true }]);
for (const player of ['waiting', 'replacement', 'removed']) actions.togglePlayerShortlisted(player);
actions.recordProvisionalPick({ pickNumber: 2, playerId: 'observed', playerName: 'Observed', position: 'WR', teamIndex: 1, teamName: 'Team 2' });
actions.correctProvisionalPick(2, { pickNumber: 3, playerId: 'replacement', playerName: 'Replacement', position: 'TE', teamIndex: 2, teamName: 'Team 3' });
actions.recordProvisionalPick({ pickNumber: 4, playerId: 'removed', playerName: 'Removed', position: 'WR', teamIndex: 3, teamName: 'Team 4' });
actions.removeProvisionalPick(4);
actions.moveShortlistedPlayer('waiting', 1);
actions.enterManualContinuity(100);
actions.branchFromPick(40);
actions.markPlayerDrafted('late', 'Late', 'WR', 9, 'Team 10', 40);
actions.markPlayerDrafted('early', 'Early', 'WR', 0, 'Team 1', 1);
const baseEntries = [...values];
const base = JSON.parse(values.get(key)!);
actions.recordProvisionalPick({ pickNumber: 5, playerId: 'retained-journal', playerName: 'Retained journal', position: 'WR', teamIndex: 4, teamName: 'Team 5' });
const after = JSON.parse(values.get(key)!);
const retained = [...values].filter(([name]) => name.startsWith('fantasy-draft-session-unconfirmed-v1:'));
assert.equal(retained.length, 1);
const retainedSnapshot = [...new Map([...baseEntries.filter(([name]) => name === key), ...retained])];
writeFileSync(output, JSON.stringify({ identity, key, complete: [...values], retained: retainedSnapshot, base, after }, null, 2));
store.dispose?.();
