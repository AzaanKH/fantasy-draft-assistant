import assert from 'node:assert/strict';
import { existsSync, writeFileSync } from 'node:fs';
import { pathToFileURL } from 'node:url';
import { createRequire } from 'node:module';

const [checkout, output] = process.argv.slice(2);
if (!checkout || !output) throw new Error('Pass checkout and output JSON path');
const load = (file: string) => import(pathToFileURL(`${checkout}/${file}`).href);
const { createDraftStore } = await load('web-app/src/stores/draftStore.ts');
const hints = await load(existsSync(`${checkout}/web-app/src/stores/draftSyncStore.ts`) ? 'web-app/src/stores/draftSyncStore.ts' : 'web-app/src/workspace/connection-hints.ts');
const { createWorkspace } = await load('web-app/src/workspace/workspace.ts');
const { createDurableWorkspace } = await load('web-app/src/workspace/durable-workspace.ts');
const { openDraftDatabase } = await load('web-app/src/workspace/indexed-db.ts');
const { decodeIndexedSession } = await load('web-app/src/workspace/idb-session.ts');
const { importV1 } = await load('web-app/src/workspace/v1-import.ts');
const { IDBFactory } = createRequire(`${checkout}/web-app/package.json`)('fake-indexeddb');
const identity = { provider: 'sleeper', draftId: '123' };
const hint = { ...identity, draftPosition: 3 };
const values = new Map<string, string>();
const storage = { get length() { return values.size; }, key: (index: number) => [...values.keys()][index] ?? null,
  getItem: (key: string) => values.get(key) ?? null, setItem: (key: string, value: string) => { values.set(key, value); }, removeItem: (key: string) => { values.delete(key); } };
Object.defineProperty(globalThis, 'window', { configurable: true, value: Object.assign(new EventTarget(), { localStorage: storage }) });
Date.now = () => 1770000000000;
let random = 1;
Math.random = () => ((random++ * 7919) % 104729) / 104729;
const legacy = existsSync(`${checkout}/web-app/src/stores/draftSyncStore.ts`);
const draftStore = createDraftStore({ storage });
const workspace = legacy ? createWorkspace({ draftStore, connectionStore: (await load('web-app/src/stores/draftSyncStore.ts')).createDraftSyncConnectionStore({ initialConnection: hint, persist: hints.persistConnection }) })
  : createWorkspace({ draftStore, initialConnection: hint, persist: hints.persistConnection });
workspace.send('connection.confirmDraftPosition', 3);
workspace.send('setConfig', { myPickPosition: 3 });
workspace.send('setSessionMode', 'live');
workspace.send('recordProvisionalPick', { pickNumber: 1, playerId: 'retained', playerName: 'Retained', position: 'WR', teamIndex: 0, teamName: 'Team 1' });
workspace.send('togglePlayerShortlisted', 'retained-queue');
const commonFlow = [...values].sort(([a], [b]) => a.localeCompare(b));
workspace.send('setConfig', { myPickPosition: 8 });
const off = [...values].sort(([a], [b]) => a.localeCompare(b));
workspace.dispose();
const database = await openDraftDatabase({ factory: new IDBFactory(), decode: decodeIndexedSession, report: (error: unknown) => { throw error; } });
const imported = importV1(off.filter(([key]) => key.startsWith('fantasy-draft-session')).map(([key, serialized]) => ({ key, serialized })));
assert.equal(imported.rejected.length, 0); assert.equal(imported.unresolved.length, 0);
await database.importV1(imported);
const durable = createDurableWorkspace({ database, search: '', initialConnection: hint });
await durable.sendDurable(['setSessionMode', 'live']);
await durable.sendDurable(['setConfig', { myPickPosition: 6 }]);
const on = await database.read(identity);
assert.equal(on.config.myPickPosition, 6);
assert.equal(on.draftHistory[0].playerId, 'retained');
assert.deepEqual(on.shortlistedPlayerIds, ['retained-queue']);
assert.deepEqual([...values].filter(([key]) => key.startsWith('fantasy-draft-session')).sort(([a], [b]) => a.localeCompare(b)), off.filter(([key]) => key.startsWith('fantasy-draft-session')), 'ON touched v1 session or journal source bytes');
durable.dispose();
writeFileSync(output, JSON.stringify({ checkout, legacy, commonFlow, switchOff: off, switchOn: on, v1UnchangedAfterIdb: true }, null, 2));
