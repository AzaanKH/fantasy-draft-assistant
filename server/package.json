{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@fantasy-draft/source src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run --config ../vitest.config.js --project server",
    "typecheck": "tsc --noEmit",
    "lint": "node ../scripts/lint.mjs server",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fantasy-draft/shared": "workspace:*",
    "effect": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.0",
    "vite": "^6.4.3"
  }
}
