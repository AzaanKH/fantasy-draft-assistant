{
  "name": "extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "node ../scripts/lint.mjs extension",
    "test": "vitest run --config ../vitest.config.js --project extension",
    "test:watch": "vitest --config ../vitest.config.js --project extension",
    "clean": "rm -rf dist node_modules/.vite"
  },
  "dependencies": {
    "@fantasy-draft/shared": "workspace:*",
    "effect": "^4.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.2",
    "typescript": "^5.9.0",
    "vite": "^6.4.3"
  }
}
