{
  "name": "fantasy-draft-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "Fantasy football draft assistant with a React web app and Chrome extension for ESPN, Yahoo, and Sleeper",
  "type": "module",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "predev": "pnpm data:check && pnpm --filter scripts check:dev-ports",
    "dev": "pnpm --filter scripts dev",
    "dev:live": "pnpm draft:preflight && pnpm dev",
    "dev:shared": "pnpm --filter @fantasy-draft/shared build --watch",
    "dev:web": "pnpm --filter web-app dev",
    "dev:server": "pnpm --filter server dev",
    "dev:extension": "pnpm --filter extension dev",
    "build": "pnpm --filter @fantasy-draft/shared build && pnpm -r --filter '!@fantasy-draft/shared' build && pnpm test:contracts",
    "build:web": "pnpm --filter web-app build",
    "build:web:demo": "BROWSER_DATA_SOURCE=demo VITE_DEMO_MODE=true VITE_STORAGE_ACTIVATION=v1 pnpm --filter web-app build",
    "dev:web:demo": "BROWSER_DATA_SOURCE=demo VITE_DEMO_MODE=true VITE_STORAGE_ACTIVATION=v1 pnpm --filter web-app dev",
    "measure:web-bundle": "pnpm build:web && pnpm --filter scripts measure:web-bundle",
    "measure:effect-adoption": "pnpm --filter scripts measure:effect-adoption",
    "build:server": "pnpm --filter server build",
    "build:extension": "pnpm --filter extension build",
    "typecheck": "pnpm run -r typecheck",
    "docs:generate": "pnpm --filter scripts exec tsx ../scripts/generate-docs.mjs",
    "docs:check": "pnpm --filter scripts exec tsx ../scripts/generate-docs.mjs --check",
    "lint": "pnpm docs:check && pnpm check:tracked-leaks && pnpm check:tracked-data && node scripts/check-workspace-gates.mjs && pnpm run -r lint",
    "test": "vitest run --project '!scripts-contract'",
    "verify": "pnpm typecheck && pnpm lint && pnpm tokens:check && pnpm test && pnpm build",
    "tokens:check": "node scripts/design-tokens.mjs",
    "tokens:write": "node scripts/design-tokens.mjs --write",
    "browser:gate": "pnpm --filter scripts browser:gate",
    "draft:preflight": "pnpm --filter scripts prepare:live-draft",
    "draft:readiness": "pnpm --filter scripts check:draft-readiness",
    "draft:rehearsal": "pnpm --filter web-app rehearse:primary-league",
    "draft:release-gate": "pnpm --filter scripts primary-league:release-gate",
    "experiment:primary-league": "pnpm --filter web-app experiment:primary-league",
    "scrape:ecr": "pnpm --filter scripts scrape:ecr",
    "refresh:fantasypros": "pnpm --filter scripts refresh:fantasypros-snapshot",
    "refresh:fantasypros:manual": "pnpm scrape:ecr && FANTASYPROS_SNAPSHOT_MODE=manual pnpm --filter scripts refresh:fantasypros-snapshot",
    "refresh:sleeper": "pnpm --filter scripts fetch:sleeper",
    "import:sportsbook": "pnpm --filter scripts import:sportsbook",
    "data:identity": "pnpm --filter scripts build:player-identity",
    "refresh:team-env": "pnpm --filter scripts generate:team-env",
    "refresh:daily": "pnpm refresh:sleeper && pnpm refresh:fantasypros && pnpm data:identity && pnpm refresh:contracts && pnpm refresh:team-env",
    "scrape:contracts": "pnpm --filter scripts scrape:contracts",
    "refresh:contracts": "pnpm --filter scripts refresh:contracts",
    "data:demo:build": "pnpm --filter scripts build:demo-data && pnpm data:demo:check",
    "data:demo:install": "pnpm --filter scripts install:demo-data",
    "data:demo:check": "pnpm --filter scripts check:demo-data",
    "data:check": "pnpm --filter scripts check:data-freshness && pnpm --filter scripts check:data-quality",
    "data:check:strict": "pnpm --filter scripts check:data-freshness --strict && pnpm --filter scripts check:data-quality --strict",
    "model:duckdb:init": "pnpm --filter scripts model:duckdb:init",
    "model:profile": "pnpm --filter scripts model:profile",
    "model:dataset": "pnpm model:duckdb:init && pnpm --filter scripts model:dataset",
    "model:snapshots": "pnpm --filter scripts model:snapshots",
    "model:league-survival": "pnpm --filter scripts build:league-survival",
    "model:backtest": "pnpm --filter scripts backtest:recommendations",
    "model:backtest:contracts": "pnpm --filter scripts backtest:contracts",
    "report:draft-prep": "pnpm --filter scripts generate:draft-prep",
    "prepare:draft": "pnpm refresh:daily && pnpm model:dataset && pnpm model:league-survival && pnpm model:backtest && pnpm model:backtest:contracts && pnpm report:draft-prep && pnpm data:check:strict",
    "clean": "pnpm run -r clean && rm -rf node_modules",
    "sync:pair": "pnpm --filter server exec tsx --conditions=@fantasy-draft/source src/pair-extension.ts",
    "audit:security": "pnpm audit --audit-level=moderate",
    "draft": "node cli/bin/draft.mjs",
    "build:cli": "pnpm --filter @fantasy-draft/shared build && pnpm --filter @fantasy-draft/cli build",
    "test:contracts": "vitest run --project scripts-contract",
    "test:persistence": "node --test scripts/persistence/check-audit.mjs && node scripts/persistence/run.mjs",
    "check:tracked-leaks": "node scripts/check-tracked-leaks.mjs",
    "check:tracked-data": "pnpm --filter scripts exec tsx ../scripts/check-tracked-data.mjs",
    "check:pr-size": "node scripts/check-pr-size.mjs",
    "check:draft-effect": "node scripts/check-draft-effect.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@eslint/js": "^9.16.0",
    "eslint": "^9.16.0",
    "globals": "^15.13.0",
    "typescript-eslint": "^8.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "vitest": "^4.1.12",
    "jsdom": "^26.0.0",
    "tinyglobby": "^0.2.15",
    "yaml": "^2.8.1"
  },
  "pnpm": {
    "overrides": {
      "minimatch@3": "^3.1.4",
      "minimatch@9": "^9.0.7",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@2": "^2.1.4",
      "rollup@4": "^4.59.0",
      "postcss@8": "^8.5.23",
      "source-map-js@1": "^1.2.2",
      "flatted@3": "^3.4.2",
      "js-yaml@4": "^4.3.1",
      "nanoid@3": "^3.3.18",
      "ajv@6": "^6.14.0",
      "picomatch@4": "^4.0.4",
      "@humanfs/node@0.16": "^0.16.8"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-g3hv-75wg-m249"
      ]
    }
  },
  "bin": {
    "draft": "cli/bin/draft.mjs"
  }
}
